# SQLite par défaut. PostgreSQL : postgresql+psycopg://wikidex:mot-de-passe@localhost:5432/wikidex
# DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=0
ENABLE_LEGACY_IMPORT=1
# Contact du projet pour les API Wikimedia ; personnaliser pour un autre déploiement.
# Les requêtes vont à Wikimedia, pas à GitHub.
WIKIMEDIA_USER_AGENT=Wikidex/1.0 (+https://github.com/Kantus8/WikiCollect)
